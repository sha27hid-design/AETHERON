{
  "name": "aetheron",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@aetheron/api\" \"npm run dev --workspace=@aetheron/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
